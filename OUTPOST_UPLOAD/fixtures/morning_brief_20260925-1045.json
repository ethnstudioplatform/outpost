{"question": "What changed in the world's conflicts overnight?", "country": "UA", "voice_speed": 1.12, "gap": 0.12, "scene_gap": 0.05, "short": true, "hook": true, "hook_lines": ["MORNING BRIEF: 3 STORIES", "Ukraine, Russia, Ethiopia"], "cover": ["MORNING BRIEF.", "3 STORIES.", "FAST."], "region": "WORLD", "places": {"KYIV": {"id": "KYIV", "name": "Kyiv", "lat": 50.45, "lon": 30.52}, "GULF": {"id": "GULF", "name": "Gulf of Finland", "lat": 59.9, "lon": 25.5}, "LALIBELA": {"id": "LALIBELA", "name": "Lalibela", "lat": 12.03, "lon": 39.04}, "MEKELLE": {"id": "MEKELLE", "name": "Tigray", "lat": 13.5, "lon": 39.47}}, "lines": [{"text": "One. Zelensky says Trump has made a final decision: Ukraine will get licences to make its own Patriot missiles.", "src": [0, 1], "context": false, "note": "Euronews, 25 Sep 2026", "scene": {"type": "pin", "place": "KYIV", "head": "Patriot licence", "notes": ["Zelensky, 25 Sep", "made in Ukraine"], "span": 9}}, {"text": "In July, Trump said: we have not agreed to that.", "src": [0], "context": false, "note": "Euronews, 25 Sep 2026", "scene": {"type": "quote", "quote": "we have not agreed to that", "who": "Donald Trump, July 2026", "flag": "US"}}, {"text": "Two. Finnish and Swedish fighter jets intercepted Russian military aircraft over the Gulf of Finland.", "src": [2, 3], "context": false, "note": "Finnish Air Force, 24 Sep 2026", "scene": {"type": "pin", "place": "GULF", "head": "Russian jets identified", "notes": ["MiG-31, Su-30, Tu-134", "24 Sep 2026"], "span": 9}}, {"text": "Their first ever joint mission.", "src": [2], "context": false, "note": "Finnish Air Force, 24 Sep 2026", "scene": {"type": "statement", "lines": ["Finland + Sweden.", "First joint mission."], "flag": "FI"}}, {"text": "Three. War is back in northern Ethiopia, with heavy fighting around Lalibela.", "src": [4, 5], "context": false, "note": "AFP via Dawn, 25 Sep 2026", "scene": {"type": "pin", "place": "LALIBELA", "head": "Heavy fighting", "notes": ["Tigray, Afar, Amhara", "25 Sep 2026"], "span": 9}}, {"text": "Tigray's internet has gone dark.", "src": [4], "context": false, "note": "Netblocks via AFP, 25 Sep 2026", "scene": {"type": "statement", "lines": ["Tigray:", "internet down."], "flag": "ET"}}, {"text": "The last war there killed around 600,000 people.", "src": [4], "context": false, "note": "AFP via Dawn, 25 Sep 2026", "scene": {"type": "number", "value": "600,000", "label": "killed, 2020 to 2022", "detail": "estimate, AFP", "flag": "ET"}}, {"text": "Which one should we follow?", "src": [], "context": true, "note": "", "scene": {"type": "wide"}}], "sources": [{"n": 0, "outlet": "Euronews", "title": "Trump makes 'final decision' to grant Ukraine Patriot license, Zelenskyy says", "url": "https://www.euronews.com/2026/09/25/trump-makes-final-decision-to-grant-ukraine-patriot-license-zelenskyy-says"}, {"n": 1, "outlet": "Kyiv Post", "title": "Trump Made 'Final Decision' on Patriot License Transfer to Ukraine, Zelensky Says", "url": "https://www.kyivpost.com/post/85174"}, {"n": 2, "outlet": "Finnish Air Force", "title": "Finland and Sweden identify Russian aircraft together for the first time", "url": "https://ilmavoimat.fi/en/-/finland-and-sweden-identify-russian-aircraft-together-for-the-first-time"}, {"n": 3, "outlet": "The Jerusalem Post", "title": "Swedish, Finnish fighter jets rush to intercept Russian military aircraft", "url": "http://www.jpost.com/international/article-909670"}, {"n": 4, "outlet": "Dawn (AFP)", "title": "Heavy fighting, internet disruption as Ethiopia conflict rages", "url": "https://www.dawn.com/news/2032567/heavy-fighting-internet-disruption-as-ethiopia-conflict-rages"}, {"n": 5, "outlet": "RTE", "title": "Fighting rages in Ethiopia as civil war resumes", "url": "https://www.rte.ie/news/world/2026/0925/1592922-ethiopia-tigray/"}], "caption": "Your OUTPOST morning brief: Zelensky says Ukraine will make its own Patriot missiles, Finland and Sweden intercept Russian jets together for the first time, 