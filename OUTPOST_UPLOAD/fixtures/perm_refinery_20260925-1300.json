{"question": "Is anywhere in Russia out of range?", "country": "RU", "voice_speed": 0.95, "gap": 0.4, "hook": true, "hook_lines": ["DRONES HIT 1,500KM DEEP", "Russia's Perm refinery"], "cover": ["1,500 KM.", "ONE REFINERY.", "ON FIRE."], "region": "RUSSIA / UKRAINE", "places": {"UKRAINE": {"id": "UKRAINE", "name": "Ukraine", "lat": 51.3, "lon": 33.9}, "PERM": {"id": "PERM", "name": "Perm", "lat": 58.01, "lon": 56.25}, "NOVOSH": {"id": "NOVOSH", "name": "Novoshakhtinsk", "lat": 47.76, "lon": 39.93}, "ULYANOVSK": {"id": "ULYANOVSK", "name": "Ulyanovsk", "lat": 54.32, "lon": 48.4}, "KYIV": {"id": "KYIV", "name": "Kyiv", "lat": 50.45, "lon": 30.52}, "MOSCOW": {"id": "MOSCOW", "name": "Moscow", "lat": 55.75, "lon": 37.62}}, "lines": [{"text": "Ukrainian drones have hit one of Russia's biggest oil refineries, about 1,500 kilometres inside Russia.", "src": [0, 1], "context": false, "note": "EA WorldView, 25 Sep", "scene": {"type": "flow", "from": "UKRAINE", "to": ["PERM"], "label": "1,500 km inside Russia"}}, {"text": "It is the Lukoil refinery in Perm, near the Ural Mountains.", "src": [0, 1], "context": false, "note": "Moscow Times / EAWV, 25 Sep", "scene": {"type": "pin", "place": "PERM", "head": "Lukoil refinery, Perm", "notes": ["Ural Mountains", "set ablaze"]}}, {"text": "It processes more than 13 million tonnes of crude a year.", "src": [2], "context": false, "note": "Kyiv Post, 25 Sep", "scene": {"type": "number", "value": "13M", "label": "tonnes of crude a year", "detail": "Perm refinery", "flag": "RU"}}, {"text": "Perm's governor called it a massive UAV attack.", "src": [2], "context": false, "note": "Kyiv Post, 25 Sep", "scene": {"type": "quote", "quote": "massive UAV attack", "who": "Gov. Dmitry Makhonin", "flag": "RU"}}, {"text": "The Moscow Times reports one person was killed there.", "src": [1], "context": false, "note": "Moscow Times, 25 Sep", "scene": {"type": "number", "value": "1", "label": "killed in Perm", "detail": "Moscow Times", "flag": "RU"}}, {"text": "It is the second drone attack on this refinery since the 21st of August.", "src": [2], "context": false, "note": "Kyiv Post, 25 Sep", "scene": {"type": "statement", "lines": ["2nd attack", "since 21 August."], "flag": "RU"}}, {"text": "In Rostov, the governor says the Novoshakhtinsk refinery has stopped work.", "src": [1, 2], "context": false, "note": "Moscow Times / Kyiv Post", "scene": {"type": "pin", "place": "NOVOSH", "head": "Refinery halted", "notes": ["Rostov region", "governor says"]}}, {"text": "Ukraine's General Staff says two Russian radar stations near it were also hit.", "src": [3], "context": false, "note": "Ukrinform, 25 Sep", "scene": {"type": "statement", "lines": ["2 radar stations.", "Ukraine says: hit."], "flag": "UA"}}, {"text": "In Ulyanovsk, drones hit the Iskra plant, which makes missile parts, Kyiv Post says.", "src": [2], "context": false, "note": "Kyiv Post, 25 Sep", "scene": {"type": "pin", "place": "ULYANOVSK", "head": "Iskra plant hit", "notes": ["missile parts", "Ulyanovsk"]}}, {"text": "The local governor says eight people were injured there, including a child.", "src": [2], "context": false, "note": "Kyiv Post, 25 Sep", "scene": {"type": "number", "value": "8", "label": "injured in Ulyanovsk", "detail": "regional governor", "flag": "RU"}}, {"text": "Russia's defence ministry says it intercepted 592 Ukrainian drones overnight.", "src": [1], "context": false, "note": "Moscow Times, 25 Sep", "scene": {"type": "number", "value": "592", "label": "drones, Russia says", "detail": "defence ministry claim", "flag": "RU"}}, {"text": "In Kyiv, officials say a Russian drone killed a 14-year-old boy the same night.", "src": [1], "context": false, "note": "Moscow Times, 25 Sep", "scene": {"type": "pin", "place": "KYIV", "head": "Kyiv hit overnight", "notes": ["boy, 14, killed", "officials say"]}}, {"text": "Three Russian regions hit in one night: Perm, Rostov and Ulyanovsk.", "src": [1, 2], "context": false, "note": "Moscow Times / Kyiv Post", "scene": {"type": "flow", "from": "UKRAINE", "to": ["NOVOSH", "ULYANOVSK", "PERM"], "label": "3 regions, 1 night"}}, {"text": "Is anywhere in Russia now out of range? Tell us below.", "src": [], "context": true, "note": "", "scene": {"type": "wide"}}], "sources": [{"n": 0, "outlet": "EA WorldView", "title": "Ukraine War, Day 1,674: Kyiv Strikes Oil Refinery 1,500 Kilometers Inside Russia", "url": "https://eaworldview.com/2026/09/ukraine-war-russia-kyiv-strikes-oil-refinery/"}, {"n": 1, "outlet": "The Moscow Times", "title": "At Least 2 Killed as Ukraine Strikes Industrial Sites Across Russia", "url": "https://www.themoscowtimes.com/2026/09/25/at-least-2-killed-as-ukraine-strikes-industrial-sites-across-russia-a93790"}, {"n": 2, "outlet": "Kyiv Post", "title": "Ukrainian Drone Barrage Hits Russian Refineries, Missile-Parts Plant", "url": "https://www.kyivpost.com/post/85374"}, {"n": 3, "outlet": "Ukrinform", "title": "Ukrainian Defense Forces strike oil refineries in Perm and Novoshakhtinsk and two Russian radar stations", "url": "https://www.ukrinform.net/rubric-ato/4167962-ukrainian-defense-forces-strike-oil-refineries-in-perm-and-novoshakhtinsk-and-two-russian-radar-stations.html"}], "caption": "Ukrainian drones have set Lukoil's Perm refinery ablaze, about 1,500 km inside Russia, and another refinery in Rostov has stopped work. Russia says it intercepted 592 drones in one night. Is anywhere in Russia now out of range?", "hashtags": ["ukraine", "russia", "perm", "lukoil", "outpost"]}